5. Introdução a Props, Hooks e Renderização Condicional

bash

```sh
git clone https://github.com/conteudoGeneration/react_playground_ts

npm install

npm run dev
```

src/pages/home/Home.tsx

```tsx
interface homeProps {
  titulo: string;
  texto: string;
}

function Home(props: homeProps) {
  return (
    <div>
      <h2>{props.titulo}</h2>
      <p>{props.texto}</p>
    </div>
  );
}

export default Home;
```

src/App.tsx

```tsx
import "./App.css";
import Home from "./pages/home/Home";

function App() {
  return (
    <>
      <Home
        titulo="Componente Home"
        texto="Este é o componente Home, que recebe props."
      />
    </>
  );
}

export default App;
```

src/pages/contador/Contador.tsx

```tsx
import { useState } from "react";

function Contador() {
  const [valor, setValor] = useState(0);

  function handleClick() {
    setValor(valor + 1);
  }

  return (
    <div>
      <h2>Componente Contador</h2>
      <p>O valor atual é: {valor}</p>
      <button onClick={handleClick}>Adicionar 1</button>
    </div>
  );
}

export default Contador;
```

src/App.tsx

```tsx
import "./App.css";
import Contador from "./pages/contador/Contador";

function App() {
  return (
    <>
      <Contador />
    </>
  );
}

export default App;
```

src/pages/tarefa/Tarefa.tsx

```tsx
import { useState, useEffect } from "react";

function Tarefa() {
  const [completed, setCompleted] = useState(false);
  const [tarefa, setTarefa] = useState("");

  useEffect(() => {
    if (completed) {
      setTarefa("Parabéns! Você concluiu a tarefa!");
    }
  }, [completed]);

  return (
    <div>
      <h2>Componente Tarefa</h2>
      <h3>{tarefa}</h3>
      <p>Conclua a tarefa</p>
      <button onClick={() => setCompleted(true)}>Concluir Tarefa</button>
    </div>
  );
}

export default Tarefa;
```

src/App.tsx

```tsx
import "./App.css";
import Tarefa from "./pages/tarefa/Tarefa";

function App() {
  return (
    <>
      <Tarefa />
    </>
  );
}

export default App;
```

src/pages/login/Login.tsx

```tsx
import { useState } from "react";
import Home from "../home/Home";

function Login() {
  const [isLogged, setIsLogged] = useState(false);

  return (
    <>
      {isLogged ? (
        <Home titulo="Componente Home" texto="Bem-vindo de Volta!" />
      ) : (
        <div>
          <h2>Componente Login</h2>
          <button onClick={() => setIsLogged(true)}>Entrar</button>
        </div>
      )}
    </>
  );
}

export default Login;
```

src/App.tsx

```tsx
import "./App.css";
import Login from "./pages/login/Login";

function App() {
  return (
    <>
      <Login />
    </>
  );
}

export default App;
```

